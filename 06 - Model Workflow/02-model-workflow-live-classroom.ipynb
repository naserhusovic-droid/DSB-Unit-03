     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# E - Equal variance of errors\n",
    "# Residual plot\n",
    "plt.figure(figsize = (10, 7))\n",
    "plt.scatter(y_pred, resids, color = 'teal', edgecolor = 'black')\n",
    "plt.axhline(0, color = 'black');\n",
    "\n",
    "# Heteroscedasticity (!!)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
