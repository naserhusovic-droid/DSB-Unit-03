   ],
   "source": [
    "# N - Normality of errors\n",
    "y_pred = lr.predict(X_train)\n",
    "resids = y_train - y_pred\n",
    "\n",
    "plt.figure(figsize = (8, 6))\n",
    "plt.hist(resids, bins = 25, color = 'teal', edgecolor = 'black');\n",
    "\n",
    "# Fine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
   "outputs": [
    {
